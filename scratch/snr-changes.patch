diff --git a/src/lib/snr-bridge.js b/src/lib/snr-bridge.js
new file mode 100644
index 000000000..f6026e5b3
--- /dev/null
+++ b/src/lib/snr-bridge.js
@@ -0,0 +1,69 @@
+/**
+ * SNR EduOS — мост между редактором и платформой.
+ *
+ * Родные кнопки «Сохранить», «Поделиться» и «Мои работы» рассчитаны на серверы
+ * scratch.mit.edu, к которым эта копия не подключена: без правки «Сохранить»
+ * скрыт флагом canSave, а две другие показывают подсказку «скоро». Здесь они
+ * переводятся на платформу: редактор отдаёт файл проекта наружу событием окна,
+ * сохраняет уже платформа.
+ *
+ * Логика редактора не тронута — это тонкая обвязка вокруг vm.saveProjectSb3().
+ * Контракт сообщений описан на стороне платформы (apps/web/lib/scratch-bridge.ts);
+ * общий модуль невозможен, это разные сборки.
+ */
+
+const FROM_SCRATCH = 'snr-scratch';
+const FROM_PLATFORM = 'snr-platform';
+
+const inFrame = () => typeof window !== 'undefined' && window.parent !== window;
+
+const post = message => {
+    if (!inFrame()) return;
+    // '*' осознанно: адрес платформы этой сборке неизвестен, а секретов в
+    // сообщении нет — это тот же файл, который ученик может скачать кнопкой
+    // «Сохранить на свой компьютер».
+    window.parent.postMessage(message, '*');
+};
+
+/**
+ * Отдать текущий проект платформе.
+ * @param {object} vm - экземпляр VM редактора
+ * @param {string} type - 'save' или 'share'
+ * @param {string} name - название работы
+ * @returns {Promise<boolean>} удалось ли отдать
+ */
+const sendProject = (vm, type, name) => {
+    if (!vm || typeof vm.saveProjectSb3 !== 'function') return Promise.resolve(false);
+    return vm.saveProjectSb3()
+        .then(blob => blob.arrayBuffer())
+        .then(sb3 => {
+            post({source: FROM_SCRATCH, type: type, name: name || 'Без названия', sb3: sb3});
+            return true;
+        })
+        .catch(() => false);
+};
+
+/**
+ * Открыть список сохранённых работ на стороне платформы.
+ * @returns {void}
+ */
+const openMyProjects = () => post({source: FROM_SCRATCH, type: 'my-projects'});
+
+/**
+ * Приём проекта от платформы. Вызывается один раз при монтировании меню.
+ * @param {object} vm - экземпляр VM редактора
+ * @returns {void}
+ */
+const listen = vm => {
+    if (!inFrame()) return;
+    window.addEventListener('message', e => {
+        const d = e.data;
+        if (!d || typeof d !== 'object' || d.source !== FROM_PLATFORM) return;
+        if (d.type === 'load' && d.sb3 && vm) {
+            vm.loadProject(d.sb3).catch(() => {});
+        }
+    });
+    post({source: FROM_SCRATCH, type: 'ready'});
+};
+
+export {sendProject, openMyProjects, listen};
